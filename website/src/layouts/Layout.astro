---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Senpwai — Batch download anime',
  description = 'An open-source desktop and mobile app for batch downloading anime and keeping up with new episodes.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/images/senpwai-icon.webp" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0d" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/screenshots/desktop/home.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/screenshots/desktop/home.webp" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Navbar />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
