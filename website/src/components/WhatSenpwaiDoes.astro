---
import {
  Download,
  FolderCheck,
  ListOrdered,
  Wrench,
  Waypoints,
  Globe2,
  Share2,
  CalendarSync,
  Target,
  Sliders,
  Tv,
  Languages,
  FastForward,
  Radio,
  HardDrive,
  Scan,
  CheckCheck,
  Boxes,
  SlidersHorizontal,
  CheckSquare,
  ArrowUpDown,
  PauseCircle,
  Gauge,
  Bell,
} from 'lucide-astro';
import { Image } from 'astro:assets';
import animePaheIcon from '../assets/images/animepahe-icon.webp';
import nyaaIcon from '../assets/images/nyaa-icon.webp';
import tokyoInsiderIcon from '../assets/images/tokyoinsider-icon.webp';

const features = [
  {
    icon: Waypoints,
    title: 'Multiple sources',
    logos: [
      { src: animePaheIcon, alt: 'AnimePahe' },
      { src: nyaaIcon, alt: 'Nyaa' },
      { src: tokyoInsiderIcon, alt: 'TokyoInsider' },
    ],
    items: [
      { icon: Globe2, label: 'Direct HTTP & web downloads' },
      { icon: Share2, label: 'High quality torrent streams' },
      { icon: Sliders, label: 'Choose your preferred download source' },
    ],
  },
  {
    icon: Download,
    title: 'Batch & range downloads',
    items: [
      { icon: Tv, label: '360p to 1080p video resolutions' },
      { icon: Languages, label: 'Subtitled or dubbed audio streams' },
      { icon: FastForward, label: 'Automatically skip filler episodes' },
    ],
  },
  {
    icon: CalendarSync,
    title: 'Automatic episode tracking',
    items: [
      { icon: Radio, label: 'Track ongoing seasonal releases' },
      { icon: Bell, label: 'Auto-downloads & notifies when new episodes air' },
      { icon: HardDrive, label: 'Preserves preferred source, quality & destination folder' },
    ],
  },
  {
    icon: FolderCheck,
    title: 'Smart library scan',
    items: [
      { icon: Scan, label: 'Scans multiple media directories' },
      { icon: CheckCheck, label: 'Skips episodes already in your library' },
    ],
  },
  {
    icon: Target,
    title: 'Precision torrent matching',
    logos: [{ src: nyaaIcon, alt: 'Nyaa' }],
    items: [
      { icon: Boxes, label: 'Matches single episodes & full batch releases' },
      { icon: SlidersHorizontal, label: 'Matches quality & dual-audio options' },
      { icon: CheckSquare, label: 'Review and approve uncertain matches' },
    ],
  },
  {
    icon: ListOrdered,
    title: 'Unified queue management',
    items: [
      { icon: ArrowUpDown, label: 'Reorder download priorities on the fly' },
      { icon: PauseCircle, label: 'Pause and resume downloads anytime' },
      { icon: Gauge, label: 'Real-time speed, seeders, peers & ETA stats' },
    ],
  },
];
---

<section id="features" class="feature-section shell">
  <div class="section-intro">
    <p class="eyebrow"><Wrench size={14} class="inline-icon" /> The useful bits</p>
    <h2 class="display">What Senpwai does.</h2>
  </div>

  <div class="feature-grid">
    {features.map((feature) => {
      const MainIcon = feature.icon;
      return (
        <article class="feature-card">
          <div class="card-header">
            <div class="icon-box">
              <MainIcon size={20} class="icon-svg" aria-hidden="true" />
            </div>
            {feature.logos && (
              <div class="source-badges" aria-label="Download sources">
                {feature.logos.map((logo) => (
                  <span class="source-badge" title={logo.alt}>
                    <Image src={logo.src} alt={logo.alt} width={15} height={15} densities={[1, 2]} />
                    <span>{logo.alt}</span>
                  </span>
                ))}
              </div>
            )}
          </div>

          <h3 class="card-title">{feature.title}</h3>

          <ul class="feature-points" aria-label={`${feature.title} features`}>
            {feature.items.map((item) => {
              const ItemIcon = item.icon;
              return (
                <li class="point-item">
                  <ItemIcon size={14} class="point-icon" aria-hidden="true" />
                  <span>{item.label}</span>
                </li>
              );
            })}
          </ul>
        </article>
      );
    })}
  </div>
</section>

<style>
  .feature-section {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-intro {
    max-width: 680px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .section-intro .eyebrow {
    color: #ff5252;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .section-intro h2 {
    margin: 0.8rem 0 0;
    font-size: clamp(2.4rem, 4.5vw, 4.2rem);
    line-height: 0.98;
    color: #f4f1eb;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-radius: 0.85rem;
    background: rgba(18, 18, 23, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .feature-card:hover {
    background: rgba(24, 24, 31, 0.7);
    border-color: rgba(240, 68, 68, 0.35);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }

  .icon-box {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 0.6rem;
    background: rgba(240, 68, 68, 0.12);
    border: 1px solid rgba(240, 68, 68, 0.25);
    color: #ff5252;
  }

  .source-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .source-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem 0.25rem 0.3rem;
    border-radius: 0.45rem;
    background: rgba(10, 10, 13, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #b8b6bc;
    font: 600 0.64rem 'JetBrains Mono', monospace;
    letter-spacing: -0.01em;
  }

  .source-badge img {
    width: 15px;
    height: 15px;
    object-fit: contain;
    border-radius: 0.25rem;
  }

  .card-title {
    margin: 0;
    font: 700 1.1rem/1.35 'Outfit', sans-serif;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .feature-points {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .point-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #a7a5ad;
    font: 500 0.76rem 'JetBrains Mono', monospace;
    transition: color 0.15s ease;
  }

  .feature-card:hover .point-item {
    color: #d8d6dc;
  }

  :global(.point-icon) {
    color: #ff5252;
    flex-shrink: 0;
  }

  @media (max-width: 960px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .feature-card {
      padding: 1.25rem;
    }
  }
</style>
