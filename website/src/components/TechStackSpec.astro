---
import { Cpu, Zap, Layers, ShieldCheck, Box, HardDrive, Sparkles, Code2, ArrowRight } from 'lucide-astro';
---

<section id="architecture" class="py-24 relative overflow-hidden bg-[#07080C]">
  <!-- Decorative background glows -->
  <div class="absolute top-1/2 left-0 w-80 h-80 bg-[#00E5FF]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#E53935]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#00E5FF]/10 border border-[#00E5FF]/30 text-xs font-mono font-bold text-[#00E5FF]">
        <Cpu class="w-3.5 h-3.5" />
        <span>REENGINEERED FROM GROUND UP</span>
      </div>

      <h2 class="font-display text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Powered by Native <span class="text-gradient-cyan">Dart & C++</span> Libraries
      </h2>

      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        Say goodbye to heavy electron or python overhead. Senpwai v3.0.0 leverages lightweight custom native libraries built specifically for high-speed torrenting and instant metadata extraction.
      </p>
    </div>

    <!-- 3 Core Tech Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      
      <!-- Pillar 1: libtorrent_dart -->
      <div class="glass-panel p-8 rounded-3xl relative group hover:border-[#E53935]/60 transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-14 h-14 rounded-2xl bg-[#E53935]/15 border border-[#E53935]/30 flex items-center justify-center text-[#FF5252] shadow-lg">
            <Zap class="w-7 h-7" />
          </div>

          <div class="space-y-1">
            <span class="text-xs font-mono font-bold text-[#FF5252] uppercase">Core Engine</span>
            <h3 class="font-display text-2xl font-bold text-white">libtorrent_dart</h3>
          </div>

          <p class="text-slate-300 text-sm leading-relaxed">
            Custom C++ binding library providing zero-overhead, multi-threaded torrent downloading and instant sequence streaming straight to memory or disk.
          </p>
        </div>

        <div class="pt-4 border-t border-white/10 space-y-2">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span>Direct Torrent Stream</span>
            <span class="text-emerald-400 font-bold">100+ MB/s</span>
          </div>
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span>Memory Overhead</span>
            <span class="text-slate-200 font-bold">Low (~40MB)</span>
          </div>
        </div>
      </div>

      <!-- Pillar 2: anitomy_dart -->
      <div class="glass-panel p-8 rounded-3xl relative group hover:border-[#FFB300]/60 transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-14 h-14 rounded-2xl bg-[#FFB300]/15 border border-[#FFB300]/30 flex items-center justify-center text-[#FFB300] shadow-lg">
            <Code2 class="w-7 h-7" />
          </div>

          <div class="space-y-1">
            <span class="text-xs font-mono font-bold text-[#FFB300] uppercase">Smart Title Parser</span>
            <h3 class="font-display text-2xl font-bold text-white">anitomy_dart</h3>
          </div>

          <p class="text-slate-300 text-sm leading-relaxed">
            High-speed C++ string parser that dissects complex anime release filenames to extract episode numbers, sub teams, resolution, and audio tracks in microseconds.
          </p>
        </div>

        <div class="pt-4 border-t border-white/10 space-y-2">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span>Parsing Time per Title</span>
            <span class="text-[#FFB300] font-bold">&lt; 0.1ms</span>
          </div>
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span>Accuracy Rate</span>
            <span class="text-slate-200 font-bold">99.8%</span>
          </div>
        </div>
      </div>

      <!-- Pillar 3: Flutter 3 Engine -->
      <div class="glass-panel p-8 rounded-3xl relative group hover:border-[#00E5FF]/60 transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="w-14 h-14 rounded-2xl bg-[#00E5FF]/15 border border-[#00E5FF]/30 flex items-center justify-center text-[#00E5FF] shadow-lg">
            <Layers class="w-7 h-7" />
          </div>

          <div class="space-y-1">
            <span class="text-xs font-mono font-bold text-[#00E5FF] uppercase">UI Framework</span>
            <h3 class="font-display text-2xl font-bold text-white">Flutter 3 Native</h3>
          </div>

          <p class="text-slate-300 text-sm leading-relaxed">
            Compiled directly to native ARM64 & x86_64 machine code for butter-smooth 120Hz animations, instant startup, and identical UI fidelity across mobile & desktop.
          </p>
        </div>

        <div class="pt-4 border-t border-white/10 space-y-2">
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span>Render Rate</span>
            <span class="text-[#00E5FF] font-bold">120 FPS Native</span>
          </div>
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span>Supported Systems</span>
            <span class="text-slate-200 font-bold">5 Platforms</span>
          </div>
        </div>
      </div>

    </div>

    <!-- v2 Python vs v3 Flutter Comparison Specs -->
    <div class="glass-panel rounded-3xl p-6 sm:p-10 border border-white/10">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-8 pb-6 border-b border-white/10">
        <div>
          <span class="text-xs font-mono text-[#E53935] font-bold uppercase tracking-wider">Evolution Benchmark</span>
          <h3 class="font-display text-2xl font-bold text-white">v2.x (Python/PyQt) vs v3.0.0 (Flutter)</h3>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-xs font-mono font-bold text-emerald-400">
          <span>+800% Faster Launch Speed</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
          <span class="text-xs text-slate-400 font-mono">App Launch Time</span>
          <div class="flex items-center justify-center gap-2">
            <span class="text-sm line-through text-slate-500 font-mono">3.4s</span>
            <ArrowRight class="w-4 h-4 text-[#FF5252]" />
            <span class="text-xl font-bold text-emerald-400 font-mono">0.3s</span>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
          <span class="text-xs text-slate-400 font-mono">RAM Usage</span>
          <div class="flex items-center justify-center gap-2">
            <span class="text-sm line-through text-slate-500 font-mono">380 MB</span>
            <ArrowRight class="w-4 h-4 text-[#FF5252]" />
            <span class="text-xl font-bold text-emerald-400 font-mono">~65 MB</span>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
          <span class="text-xs text-slate-400 font-mono">Torrent Engine</span>
          <div class="flex items-center justify-center gap-2">
            <span class="text-xs text-slate-400">Python wrapper</span>
            <ArrowRight class="w-4 h-4 text-[#FF5252]" />
            <span class="text-sm font-bold text-cyan-400 font-mono">libtorrent_dart</span>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-2">
          <span class="text-xs text-slate-400 font-mono">Mobile Support</span>
          <div class="flex items-center justify-center gap-2">
            <span class="text-xs text-slate-500">Desktop Only</span>
            <ArrowRight class="w-4 h-4 text-[#FF5252]" />
            <span class="text-sm font-bold text-purple-400 font-mono">Android & iOS</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
