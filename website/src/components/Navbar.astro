---
import { Download, Github, Menu, X } from 'lucide-astro';
import { Image } from 'astro:assets';
import senpwaiIcon from '../assets/images/senpwai-icon.webp';
const base = `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <div class="nav-shell">
    <a href={base} class="brand" aria-label="Senpwai home">
      <Image
        src={senpwaiIcon}
        alt=""
        width={38}
        height={38}
        densities={[1, 2]}
        loading="eager"
      />
      <span>Senpwai</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href={`${base}#features`}>Features</a>
      <a href={`${base}#showcase`}>Showcase</a>
      <a href={`${base}#themes`}>Themes</a>
      <a href={`${base}download`}>Download</a>
      <a href="https://github.com/SenZmaKi/Senpwai" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>

    <a class="nav-download" href={`${base}download`}>
      <Download size={16} aria-hidden="true" />
      Download
    </a>

    <button class="menu-button" id="menu-button" aria-label="Open navigation" aria-controls="mobile-menu" aria-expanded="false">
      <Menu id="menu-open-icon" size={22} aria-hidden="true" />
      <X id="menu-close-icon" class="hidden" size={22} aria-hidden="true" />
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu hidden" aria-label="Mobile navigation">
    <a href={`${base}#features`}>Features</a>
    <a href={`${base}#showcase`}>Showcase</a>
    <a href={`${base}#themes`}>Themes</a>
    <a href="https://github.com/SenZmaKi/Senpwai" target="_blank" rel="noopener noreferrer">
      <Github size={17} aria-hidden="true" /> GitHub
    </a>
    <a href={`${base}download`}><Download size={17} aria-hidden="true" /> Download</a>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const openIcon = document.querySelector<HTMLElement>('#menu-open-icon');
  const closeIcon = document.querySelector<HTMLElement>('#menu-close-icon');

  button?.addEventListener('click', () => {
    const willOpen = menu?.classList.contains('hidden') ?? false;
    menu?.classList.toggle('hidden', !willOpen);
    openIcon?.classList.toggle('hidden', willOpen);
    closeIcon?.classList.toggle('hidden', !willOpen);
    button.setAttribute('aria-expanded', String(willOpen));
    button.setAttribute('aria-label', willOpen ? 'Close navigation' : 'Open navigation');
  });
</script>
