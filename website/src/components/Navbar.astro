---
import { Download, Sparkles, Monitor, Smartphone, Github, Menu, X, Layers, Flame } from 'lucide-astro';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#090A0F]/80 border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#E53935] rounded-xl p-1">
      <div class="relative w-10 h-10 rounded-xl overflow-hidden bg-[#161926] p-1 border border-white/10 group-hover:border-[#E53935]/60 transition-colors shadow-lg">
        <img src="/images/senpwai-icon.png" alt="Senpwai Logo" class="w-full h-full object-contain transform group-hover:scale-105 transition-transform" />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="font-display text-xl font-extrabold tracking-tight text-white group-hover:text-[#E53935] transition-colors">Senpwai</span>
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-[#E53935]/15 text-[#FF5252] border border-[#E53935]/30">
            <span class="w-1.5 h-1.5 rounded-full bg-[#E53935] animate-pulse"></span>
            v3.0.0
          </span>
        </div>
        <span class="text-[11px] text-slate-400 font-medium tracking-wide">Flutter Anime App</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 bg-[#131520]/80 p-1.5 rounded-2xl border border-white/10 backdrop-blur-md">
      <a href="/" class="px-4 py-2 text-sm font-semibold text-slate-200 hover:text-white hover:bg-white/5 rounded-xl transition-all">
        Home
      </a>
      <a href="/#features" class="px-4 py-2 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-xl transition-all">
        Features
      </a>
      <a href="/#showcase" class="px-4 py-2 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-xl transition-all">
        Showcase
      </a>
      <a href="/#architecture" class="px-4 py-2 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-xl transition-all">
        Architecture
      </a>
      <a href="/download" class="px-4 py-2 text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 rounded-xl transition-all flex items-center gap-1.5">
        <Flame class="w-4 h-4 text-[#FF5252]" />
        Download
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="hidden md:flex items-center gap-3">
      <a 
        href="https://github.com/SenZmaKi/Senpwai" 
        target="_blank" 
        rel="noopener noreferrer"
        class="p-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 border border-white/10 transition-all focus:ring-2 focus:ring-slate-400"
        title="View GitHub Repository"
      >
        <Github class="w-5 h-5" />
      </a>

      <a 
        href="/download" 
        class="relative group overflow-hidden rounded-xl bg-gradient-to-r from-[#E53935] to-[#FF2D55] px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-[#E53935]/25 hover:shadow-[#E53935]/40 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2 border border-red-400/30"
      >
        <Download class="w-4 h-4" />
        <span>Get Senpwai v3</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-btn" 
      aria-label="Toggle navigation menu"
      class="md:hidden p-2.5 rounded-xl text-slate-300 hover:text-white bg-[#131520] border border-white/10 focus:outline-none"
    >
      <Menu id="icon-menu" class="w-6 h-6" />
      <X id="icon-close" class="w-6 h-6 hidden" />
    </button>
  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-white/10 bg-[#0B0D14]/95 backdrop-blur-2xl px-4 pt-3 pb-6 space-y-3">
    <a href="/" class="block px-4 py-3 rounded-xl text-base font-semibold text-white bg-white/5 border border-white/10">Home</a>
    <a href="/#features" class="block px-4 py-3 rounded-xl text-base font-semibold text-slate-300 hover:bg-white/5">Features</a>
    <a href="/#showcase" class="block px-4 py-3 rounded-xl text-base font-semibold text-slate-300 hover:bg-white/5">App Showcase</a>
    <a href="/#architecture" class="block px-4 py-3 rounded-xl text-base font-semibold text-slate-300 hover:bg-white/5">Flutter Engine</a>
    <a href="/download" class="block px-4 py-3 rounded-xl text-base font-semibold text-[#FF5252] hover:bg-white/5 flex items-center justify-between">
      <span>Download Hub</span>
      <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-[#E53935]/20 text-[#FF5252]">v3.0.0</span>
    </a>
    <div class="pt-2 flex items-center gap-3">
      <a 
        href="https://github.com/SenZmaKi/Senpwai" 
        target="_blank" 
        class="flex-1 py-3 px-4 rounded-xl border border-white/10 text-center font-semibold text-slate-300 flex items-center justify-center gap-2"
      >
        <Github class="w-5 h-5" />
        <span>GitHub Repo</span>
      </a>
      <a 
        href="/download" 
        class="flex-1 py-3 px-4 rounded-xl bg-[#E53935] text-center font-bold text-white shadow-md flex items-center justify-center gap-2"
      >
        <Download class="w-5 h-5" />
        <span>Get v3.0.0</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (btn && menu && iconMenu && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = menu.classList.contains('hidden');
      if (isExpanded) {
        menu.classList.remove('hidden');
        iconMenu.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
